{
  "name": "lorenzopalaia.com",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "npx knip && npm run format",
    "build": "next build --turbopack",
    "build:updated": "npm run update && npm run build",
    "postbuild": "npm run sitemap",
    "start": "next start",
    "lint": "next lint",
    "sitemap": "next-sitemap",
    "format": "prettier --write . --log-level warn",
    "knip": "knip",
    "links": "node scripts/checkBrokenLinks.js",
    "update": "npx npm-check-updates -u && npm install",
    "reinstall": "rm -rf node_modules .next .swc package-lock.json && npm install",
    "tree": "npx tree-cli -a -l 3 --ignore 'node_modules, .git, .next'"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@octokit/rest": "^22.0.1",
    "@react-email/render": "^2.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "critters": "^0.0.25",
    "framer-motion": "^13.1.0",
    "katex": "^0.18.4",
    "lucide-react": "^0.577.0",
    "next": "16.3.1",
    "next-mdx-remote": "^6.0.0",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "npm-check-updates": "^23.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "^4.0.1",
    "resend": "^6.20.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "ts-node": "^10.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.1",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "compression-webpack-plugin": "^12.0.0",
    "eslint": "^10.8.1",
    "eslint-config-next": "16.3.1",
    "knip": "^6.32.2",
    "postcss": "^8.5.26",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
